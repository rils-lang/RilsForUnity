#[derive(Default)]
pub struct LifecycleBehaviour {
    enabled: bool,
}

impl RilsBehaviour for LifecycleBehaviour {
    fn awake(&mut self, host: HostHandle) {
        host.is_valid();
        let transform = host.transform();
        transform.position_x();
        transform.position_y();
        transform.position_z();
        host.active_self();
    }

    fn start(&mut self, host: HostHandle) {
        host.is_valid();
    }

    fn update(&mut self, host: HostHandle, delta_seconds: f32) {
        host.is_valid();
        let _ = delta_seconds;
    }

    fn on_destroy(&mut self, host: HostHandle) {
        host.is_valid();
    }
}
